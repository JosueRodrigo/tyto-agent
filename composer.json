{
    "name": "tyto/agent",
    "description": "Tyto observability agent for Laravel applications.",
    "keywords": [
        "laravel",
        "monitoring",
        "tyto",
        "observability"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "guzzlehttp/promises": "^2.0",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^3.6",
        "nesbot/carbon": "^2.0|^3.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "ramsey/uuid": "^4.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/http-foundation": "^6.0|^7.0|^8.0",
        "symfony/polyfill-php84": "^1.29"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "laravel/pint": "1.21.0",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "replace": {
        "laraowl/client": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Laraowl\\Client\\": "src/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php vendor/bin/phpunit --testsuite Unit",
        "check": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan --memory-limit=-1",
            "@test"
        ],
        "lint": [
            "@php vendor/bin/phpstan --memory-limit=-1 --verbose",
            "@php vendor/bin/pint --cache-file=.pint.cache"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraowl\\Client\\LaraowlClientServiceProvider"
            ],
            "aliases": {
                "TytoAgent": "Laraowl\\Client\\Facades\\LaraowlClient",
                "LaraowlClient": "Laraowl\\Client\\Facades\\LaraowlClient"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
